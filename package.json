{
  "name": "thesis-citation-converter",
  "version": "1.0.0",
  "description": "A modern thesis citation converter supporting multiple academic citation styles",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run build:client",
    "build:client": "webpack --mode production",
    "test": "jest"
  },
  "keywords": [
    "citation",
    "converter",
    "academic",
    "thesis",
    "apa",
    "mla",
    "chicago",
    "ieee",
    "harvard"
  ],
  "author": "Thesis Citation Converter",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^3.0.8",
    "joi": "^17.11.0",
    "cheerio": "^1.0.0-rc.12",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0"
  }
}